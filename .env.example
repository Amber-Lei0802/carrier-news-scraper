# ============================================================
# 环境变量示例 - 复制为 .env 并填写真实值
# 注意：此文件仅用于本地测试，切勿提交到 Git！
# ============================================================

# ── 大模型密钥（二选一） ──
# 方案A：Google Gemini（推荐，免费）
GEMINI_API_KEY=your_gemini_api_key_here

# 方案B：OpenAI 或兼容接口
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1   # 可选，中转地址

# ── 邮件配置 ──
# 以 QQ 邮箱为例：
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
#   SMTP_USER=your_qq_number@qq.com
#   SMTP_PASS=your_smtp_authorization_code
#   EMAIL_SENDER=your_qq_number@qq.com
#   EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com
#
# 以 Gmail 为例：
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASS=your_app_password
#   EMAIL_SENDER=your_email@gmail.com
#   EMAIL_RECIPIENTS=recipient1@example.com

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_password_or_app_password
EMAIL_SENDER=your_email@example.com
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com
